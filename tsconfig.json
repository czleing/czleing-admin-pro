{
  // 本配置覆盖 src 下所有源码（.vue / .ts / .js），供 vue-tsc 类型检查（pnpm typecheck）和编辑器使用
  "compilerOptions": {
    // 编译目标语法版本，配合 Vite 构建，直接用最新 ES 特性
    "target": "ESNext",
    // 模块系统，Vite 项目统一使用 ES Module
    "module": "ESNext",
    // 模块解析策略：Bundler 模式，按打包器行为解析（支持省略扩展名、package.json exports 等）
    "moduleResolution": "Bundler",
    // 可用的内置 API 类型库：ESNext 语法 + 浏览器 DOM API
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    // 开启全部严格检查（已隐含 noImplicitAny、strictNullChecks 等，无需再单独声明）
    "strict": true,

    // 允许 CommonJS 模块与 ES Module 互操作（如 require 包默认导入）
    "esModuleInterop": true,
    // 允许 import xx from 'cjs包' 的默认导入写法（esModuleInterop 的简写配套）
    "allowSyntheticDefaultImports": true,
    // 强制文件名大小写敏感，防止 Windows 能跑、Linux 构建失败的问题
    "forceConsistentCasingInFileNames": true,
    // 允许直接 import .json 文件并生成对应类型
    "resolveJsonModule": true,
    // 要求每个文件可被独立转译（Vite/esbuild 单文件编译的要求，禁止 const enum 等跨文件依赖特性）
    "isolatedModules": true,
    // class 字段使用 ES 标准的 define 语义（Vue 3 响应式要求，vue 官方模板默认开启）
    "useDefineForClassFields": true,
    // 跳过 node_modules 内 .d.ts 的类型检查，加快检查速度、规避第三方库自身类型问题
    "skipLibCheck": true,

    // 路径别名：与 vite.config.ts 中的 alias 对应，@ 指向 src 目录（TS 5.x 无需 baseUrl，相对本文件解析）
    "paths": {
      "@/*": ["./src/*"]
    },

    // 只加载指定的全局类型声明：vite/client 提供 import.meta.env、静态资源导入等类型
    "types": ["vite/client"],

    // 只做类型检查，不输出编译产物（产物由 Vite 构建）
    "noEmit": true
  },
  "include": [
    // 本项目为纯 TS 工程，不使用 .js / .jsx / .tsx 文件
    "src/**/*.ts",
    "src/**/*.vue"
  ],
  "exclude": ["node_modules", "dist"]
}
